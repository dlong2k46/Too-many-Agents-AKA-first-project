# Sao chép file này thành ".env" rồi điền giá trị thật.

# --- Bắt buộc ---
NVIDIA_API_KEY=

# --- Model (có giá trị mặc định hợp lý, không bắt buộc sửa) ---
MODEL_NAME=deepseek-ai/deepseek-v4.1-flash
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=2048

# --- Hành vi agent ---
MAX_ITERATIONS=4
MAX_CHAT_HISTORY_MESSAGES=5

# --- Nơi lưu log/transcript của mỗi phiên chạy ---
OUTPUT_DIR=runs

# --- Mức log hiện ra console: DEBUG, INFO, WARNING, ERROR ---
LOG_LEVEL=INFO

# --- LangSmith (tùy chọn, để trống nếu không dùng) ---
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT= 
LANGSMITH_API_KEY= 
LANGSMITH_PROJECT=

